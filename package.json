{
  "name": "canshift-tuner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CANShift Tuner — Betaflight-style web configurator. Talks to the firmware via WebSerial over the CH340 UART; hosted on Vercel.",
  "scripts": {
    "predev": "npm run tokens:gen",
    "dev": "vite",
    "prebuild": "npm run tokens:gen",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:gen": "tsx scripts/generate-tokens.css.ts",
    "prepare": "husky",
    "lint:pre-commit": "lint-staged"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@canshift/core": "^2.18.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-virtual": "3.14.9",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esptool-js": "^0.6.0",
    "immer": "^11.1.15",
    "posthog-js": "^1.386.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.25",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,md,yml,yaml,html}": "prettier --write --ignore-unknown",
    "*.{ts,tsx}": "eslint --fix --no-warn-ignored"
  }
}
