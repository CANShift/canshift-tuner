{
  "name": "canshift-tuner",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "CANShift Tuner — web configurator served by the dash in workshop mode; talks WebSocket on the dash's Wi-Fi, or WebSerial over USB from a desktop browser.",
  "scripts": {
    "predev": "npm run tokens:gen",
    "dev": "vite",
    "prebuild": "npm run tokens:gen",
    "build": "vite build && tsx scripts/check-bundle.ts",
    "bundle:dash": "npm run build && tsx scripts/pack-dash-bundle.ts",
    "preview": "vite preview",
    "mock-dash": "tsx scripts/mock-dash.ts",
    "mock-dash:sign": "tsx scripts/mock-dash-sign.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:gen": "tsx scripts/generate-tokens.css.ts",
    "prepare": "husky",
    "lint:pre-commit": "lint-staged"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@canshift/core": "^13.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "immer": "^11.1.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "husky": "^9.1.7",
    "knip": "6.42.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "ws": "8.22.0"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,md,yml,yaml,html}": "prettier --write --ignore-unknown",
    "*.{ts,tsx,mjs,cjs}": "eslint --fix --no-warn-ignored"
  }
}
